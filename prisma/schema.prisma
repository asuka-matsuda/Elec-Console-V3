generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                   String    @id @default(uuid())
  loginId              String    @unique
  password             String
  firstName            String
  lastName             String
  firstNameKana        String?
  lastNameKana         String?
  role                 String    @default("worker")
  requirePasswordReset Boolean   @default(false)
  email                String?
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Many-to-Many relation with Site
  assignedSites Site[] @relation("UserSites")
}

model Site {
  id         String    @id @default(uuid())
  name       String
  status     String    @default("planning")
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  users            User[]            @relation("UserSites")
  events           Event[]
  settings         SiteSettings?
  calendarSettings CalendarSettings?
  circuits         Circuit[]
  operationLogs    OperationLog[]
}

model Event {
  id        String   @id @default(uuid())
  siteId    String
  title     String
  start     String
  end       String?
  allDay    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id])
}

model SiteSettings {
  id                    String  @id @default(uuid())
  siteId                String  @unique
  phase2ThresholdMegOhm Float?  @default(1.0)
  enablePhase3          Boolean @default(true)
  excludedCircuits      String? // Stored as JSON string "['予備', 'スペース']"
  excelPath             String?

  site Site @relation(fields: [siteId], references: [id])
}

model CalendarSettings {
  id             String @id @default(uuid())
  siteId         String @unique
  eventTypes     String // Stored as JSON string
  holidayDays    String // Stored as JSON string "[0, 6]"
  customHolidays String // Stored as JSON string "['YYYY-MM-DD']"

  site Site @relation(fields: [siteId], references: [id])
}

model Circuit {
  id               String  @id @default(uuid())
  siteId           String
  excelRow         Int?
  joutai           String?
  keiTo            String // 幹線 / 二次側
  banShubetsu      String // 電灯 / 動力
  banMeisho        String // 1L-1, 1P-1 など
  haidenHoushiki   String? // AC 1Φ3W 100/200V など
  souShubetsu      String? // RNT, RN, TN, RST など
  kairoKigou       String?
  kairoBangou      String?
  kairoMeisho      String?
  shadankiShubetsu String?
  shadankiYouryou  String?

  cableList    String?
  haisenJousuu String?
  setsuchiUmu  String?
  setsuchiList String?

  // Phase 1 (回路確認・増し締め)
  p1Kakunin        Boolean   @default(false)
  p1Mashishime     Boolean   @default(false)
  p1Worker         String?
  p1ConfirmedAt    DateTime?
  p1Remarks        String?
  p1ModifiedFields String? // JSON array of modified field keys

  // Phase 2 (絶縁抵抗測定)
  zetsuenR      Float?
  zetsuenS      Float?
  zetsuenT      Float?
  p2RStatus     String?
  p2SStatus     String?
  p2TStatus     String?
  p2Worker      String?
  p2ConfirmedAt DateTime?
  p2Remarks     String?
  p2IsComplete  Boolean   @default(false)

  // Phase 3 (送電・電圧測定)
  denatsuRs     Float?
  denatsuSt     Float?
  denatsuRt     Float?
  kensou        String?
  p3Worker      String?
  p3ConfirmedAt DateTime?
  p3Remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, banMeisho])
  @@index([siteId, keiTo])
}

model OperationLog {
  id          String   @id @default(uuid())
  siteId      String
  timestamp   DateTime @default(now())
  worker      String
  action      String
  targetBan   String?
  targetKairo String?
  details     String?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, timestamp])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  date      String
  desc      String
  createdAt DateTime @default(now())
}

model History {
  id        String   @id @default(uuid())
  version   String
  title     String
  date      String
  desc      String
  status    String   @default("neutral")
  createdAt DateTime @default(now())
}
