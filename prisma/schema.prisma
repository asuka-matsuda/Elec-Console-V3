generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id        String   @id @default(uuid())
  siteId    String
  title     String
  start     String
  end       String?
  allDay    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}